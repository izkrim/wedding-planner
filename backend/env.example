PORT=5000
NODE_ENV=development

# MongoDB Atlas (dapatkan dari mongodb.com/atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wedding_planner?retryWrites=true&w=majority

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=ganti_dengan_random_string_panjang
JWT_EXPIRES_IN=7d

# CORS (URL frontend Anda)
CLIENT_URL=http://localhost:3000
# Production: https://wedding-planner-anda.vercel.app

# Cloudinary (cloudinary.com - free tier)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Google Maps API (console.cloud.google.com)
GOOGLE_MAPS_API_KEY=xxx